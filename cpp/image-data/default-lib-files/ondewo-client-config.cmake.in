@PACKAGE_INIT@

# Template for the installed <library_name>-config.cmake, so a consumer can
#   find_package(<library_name> CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE ondewo::<library_name>)
#
# The exported targets file names the imported targets this library was built against, so they
# have to exist before it is included. find_dependency (rather than pkg_check_modules) is used
# deliberately: it works on every consumer toolchain, including the ones that have no pkg-config
# and no .pc files at all - macOS/Homebrew, vcpkg, Conan, Windows.
include(CMakeFindDependencyMacro)
find_dependency(Protobuf)
find_dependency(gRPC CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/@ONDEWO_LIBRARY_NAME@-targets.cmake")

check_required_components("@ONDEWO_LIBRARY_NAME@")
