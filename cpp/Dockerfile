ARG DEBIAN_VERSION=trixie

FROM debian:${DEBIAN_VERSION}-slim

# Protobuf / gRPC C++ toolchain pins.
#
# Unlike the node targets this image does NOT use the repo-wide standalone PROTOC_VERSION=32.0
# release: protobuf C++ has NO cross-version gencode/runtime tolerance
# (https://protobuf.dev/support/cross-version-runtime-guarantee/ - "C++ and Rust: Require exact
# version matching with no cross-version support"), the generated code carries a poison-pill
# #error otherwise, and no prebuilt glibc C++ runtime exists for 32.0 in any apt archive.
# protoc, grpc_cpp_plugin, libprotobuf and libgrpc++ therefore all come from ONE coherent
# Debian suite, which is also what Ubuntu 24.04/25.10/26.04 ship - so a downstream consumer can
# `apt install libprotobuf-dev libgrpc++-dev` and link the artifact this image produces as-is.
#
# DEBIAN_VERSION is the real toolchain pin: the suite transitively fixes all four packages and
# therefore the ABI of every library generated by this image. Bumping it is a deliberate,
# reviewable edit, not a `stable` drift - the verification RUN block below enforces that.
ARG PROTOBUF_VERSION=3.21.12
ARG GRPC_VERSION=1.51.1

# ONDEWO_PROTO_COMPILER_VERSION; the cpp analogue of the other targets' image-data/package.json
# "version". Stamped into the generated CMake package as project(VERSION ...) and
# <name>-config-version.cmake. Kept in sync by the Makefile release targets.
ARG LIB_VERSION=5.14.0

# --------------- Installing protoc, grpc_cpp_plugin and the C++ build toolchain
# build-essential          -> g++ + make (the package build)
# cmake / pkg-config       -> configure + dependency discovery for the package build
# protobuf-compiler        -> /usr/bin/protoc (+ the well-known-type .proto files in /usr/include)
# protobuf-compiler-grpc   -> /usr/bin/grpc_cpp_plugin
# libprotobuf-dev          -> the protobuf runtime the generated stubs are compiled against
# libgrpc++-dev            -> the gRPC C++ runtime; libgrpc-dev additionally ships the CMake
#                             package config (gRPCConfig.cmake) find_package(gRPC CONFIG) needs
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake pkg-config tree \
    protobuf-compiler libprotobuf-dev \
    protobuf-compiler-grpc libgrpc++-dev libgrpc-dev libabsl-dev \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# --------------- Fail loudly if the Debian archive moved underneath the pinned ARGs
# A silent suite bump would ship stubs that no longer build against this image's own
# libprotobuf and would silently change the ABI of every published client library.
# Prefix-matched, so Debian point updates (3.21.12-11+deb13u2) still pass while a suite bump
# does not. Docker does not variable-substitute RUN lines, so the dpkg-query `${Version}`
# format string survives verbatim while the declared ARGs arrive as env vars.
RUN set -e; \
    installed_protobuf="$(dpkg-query -W -f='${Version}' libprotobuf-dev)"; \
    installed_grpc="$(dpkg-query -W -f='${Version}' libgrpc++-dev)"; \
    case "$installed_protobuf" in \
      "$PROTOBUF_VERSION"|"$PROTOBUF_VERSION"-*) ;; \
      *) echo "ERROR: libprotobuf-dev is '$installed_protobuf' but ARG PROTOBUF_VERSION=$PROTOBUF_VERSION. Update PROTOBUF_VERSION/DEBIAN_VERSION deliberately - protobuf C++ gencode and runtime must match exactly." >&2; exit 1 ;; \
    esac; \
    case "$installed_grpc" in \
      "$GRPC_VERSION"|"$GRPC_VERSION"-*) ;; \
      *) echo "ERROR: libgrpc++-dev is '$installed_grpc' but ARG GRPC_VERSION=$GRPC_VERSION. Update GRPC_VERSION/DEBIAN_VERSION deliberately." >&2; exit 1 ;; \
    esac; \
    command -v grpc_cpp_plugin >/dev/null || { echo "ERROR: grpc_cpp_plugin missing - protobuf-compiler-grpc did not install" >&2; exit 1; }; \
    pkg-config --exists protobuf grpc++ || { echo "ERROR: protobuf.pc / grpc++.pc not found - the toolchain is incomplete" >&2; exit 1; }; \
    protoc --version; \
    echo "VERIFY BLOCK PASSED: protobuf=$installed_protobuf grpc=$installed_grpc"

# --------------- Container defaults consumed by the image-data scripts
ENV GRPC_CPP_PLUGIN=/usr/bin/grpc_cpp_plugin
ENV ONDEWO_CLIENT_VERSION=${LIB_VERSION}

# --------------- Copy all files from "image-data" directory to docker container
WORKDIR /image-data
COPY image-data/ /image-data/

# --------------- Entrypoint when the docker container is executed
ENTRYPOINT ["bash","compile-proto-2-cpp.sh"]

# -----------------------------------------------------------------------------------------------------
