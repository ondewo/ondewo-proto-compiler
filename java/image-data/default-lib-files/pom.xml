<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for the generated library's maven build descriptor.

  make-lib-entry-point.sh substitutes every @…@ placeholder: the maven coordinates come from
  the orchestrator's positional arguments, every toolchain version from the image ENV (set
  from the Dockerfile ARGs). That indirection is what guarantees the pom can never name a
  version that is absent from the pre-warmed offline maven repository - the package build runs
  in maven's offline mode and would fail loudly if it did.

  NOTE: XML comments may not contain a double hyphen, so protoc/maven flags are spelled
  without their leading dashes throughout this file.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>@GROUP_ID@</groupId>
  <artifactId>@ARTIFACT_ID@</artifactId>
  <version>@VERSION@</version>
  <packaging>jar</packaging>

  <name>@ARTIFACT_ID@</name>
  <description>gRPC client stubs generated by the ondewo-proto-compiler</description>
  <url>https://github.com/ondewo/ondewo-proto-compiler</url>

  <organization>
    <name>ONDEWO GmbH</name>
    <url>https://www.ondewo.com</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>@JAVA_RELEASE@</maven.compiler.release>
    <grpc.version>@GRPC_JAVA_VERSION@</grpc.version>
    <protobuf.version>@PROTOBUF_JAVA_VERSION@</protobuf.version>
    <google.common.protos.version>@GOOGLE_COMMON_PROTOS_VERSION@</google.common.protos.version>
  </properties>

  <dependencies>
    <!-- message classes generated by protoc's java_out.
         Declared directly (depth 1) so it wins Maven's nearest-definition rule over the
         protobuf-java 3.25.9 that grpc-protobuf pulls transitively: our gencode is 4.32.x
         and protobuf only supports a runtime NEWER than the gencode, never older.
         Never move this into a BOM and never lower the version. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>
    <!-- google/api/annotations.proto, google/rpc/status.proto and google/type/latlng.proto
         are imported by the ondewo protos. Their Java classes are consumed from this jar
         instead of being generated, so they are not duplicated on the consumer classpath.
         Bumping this alone can raise its embedded gencode above protobuf.version and
         poison-pill the runtime - always re-check its protobuf-java version and raise
         protobuf.version to at least match. -->
    <dependency>
      <groupId>com.google.api.grpc</groupId>
      <artifactId>proto-google-common-protos</artifactId>
      <version>${google.common.protos.version}</version>
    </dependency>
    <!-- service stubs generated by protoc's grpc-java_out -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <!-- transport, so the published library is usable without extra wiring -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Not part of the default lifecycle, so the version must be explicit for the
           offline resolution to find it in the pre-warmed local repository. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>@MAVEN_SOURCE_PLUGIN_VERSION@</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
