<?xml version="1.0" encoding="utf-8"?>
<!--
  Template rendered into the compile directory by compile-proto-2-csharp.sh:
  @NUGET_OFFLINE_FEED@ is replaced with the value of $NUGET_OFFLINE_FEED.

  The <clear /> below drops nuget.org so a restore in this directory can only ever read the
  local folder feed that was pre-warmed at image-build time; generation must never need the
  network. This is belt and braces: the "source" option of dotnet restore already overrides
  every configured source, and dotnet build / dotnet pack run with the "no-restore" option, so
  nothing else should even try.

  Deliberately NOT copied to the output volume: /nuget/offline-feed is image-internal and does
  not exist on a client host.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="ondewo-offline" value="@NUGET_OFFLINE_FEED@" />
  </packageSources>
</configuration>
